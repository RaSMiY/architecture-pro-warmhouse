@startuml
title Диаграмма компонентов системы "Тёплый дом" — C4 Diagram

top to bottom direction

!includeurl https://raw.githubusercontent.com/RicardoNiepel/C4-PlantUML/master/C4_Component.puml

hide stereotype
!define osaPuml https://raw.githubusercontent.com/Crashedmind/PlantUML-opensecurityarchitecture2-icons/master
!include osaPuml/Common.puml
!include osaPuml/User/all.puml
!include osaPuml/Hardware/all.puml
!include osaPuml/Misc/all.puml
!include osaPuml/Server/all.puml
!include osaPuml/Site/all.puml


Container_Boundary(WarmHouseApp, "Тёплый дом") {
  Container(WebApp, "Веб-приложение", "Микросервисы", "Handles user interactions")
  Container(Database, "Database", "PostgreSQL", "Stores user data and schedules")
}

Container(WebApp, "Приложение компании Тёплый дом") {
  Component(ProfileService, "<$osa_user_green_operations>", "Личный кабинет пользователя.", "Подключение устройств, домов, создание сценариев, настройка подписок, платежей.\n\n<b>Angular</b>")
  Component(DevicesService, "<$osa_desktop_imac>", "Панель управления устройствами.", "Отображает текущее состояние. Позволяет совершать действия.\n\n<b>Angular</b>")
  Component(AAAService, "<$osa_id_card>", "Аутентификация, Авторизация, Аккаунтинг", "Проверка личности, права доступа, платежи.")
  Component(Server, "<$osa_server_web>", "Go", "Взаимодействие с базой данных, внешними устройствами, банковскими системами.")
  Component(Database, "<$osa_database>", "PostgreSQL", "Хранит данные о пользователях, домах, устройствах, сценарии, платёжные реквизиты.")
}

Rel(AAAService, Server, "Спрашивает у сервера есть ли такой пользователь.", "Если есть - получает токен на сессию и права доступа.")
Rel(DevicesService, Server, "Вызов внутреннего API управления устройствами", "Взаимодействие с устройствами идёт только через сервер.")
Rel(ProfileService, Server, "Вызов внутреннего настройки профиля", "Добавление устройств, создание сценариев, добавление платёжных реквизитов.")
Rel(Server, Database, "Сохраняет сведения о пользователях, домах, устройствах", "...")
@enduml
