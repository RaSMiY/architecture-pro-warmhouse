@startuml
' hide the spot
' hide circle
' avoid problems with angled crows feet
skinparam linetype ortho
entity "User" {
    *id : text <<uuid>>
    --
    name : text
    email : text
    phone : text
    password : text <<MD5>>
}
entity "Device" {
    *id : text <<uuid>>
    --
    name: text
    type: text <<uuid>>
    ip : text
    port : integer
    credentials: text
}
entity "DeviceType" {
    *id : text <<uuid>>
    --
    name: text
    api: jsonb
}
entity "Script" {
    *id : text <<uuid>>
    --
    content : jsonb
}

User ||..|{ Device
DeviceType ||..o{ Device
Script }o..o| User

@enduml